{
  "name": "folio-desktop",
  "version": "0.2.0",
  "description": "Local Markdown typesetting and PDF publishing for Windows",
  "author": "Justin Bogner/CambrianMinds",
  "license": "GPL-2.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "tauri": "tauri",
    "test": "vitest run",
    "test:ui": "node scripts/verify-native.mjs",
    "test:organizer": "node scripts/verify-organizer.mjs",
    "prepare:binaries": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-binaries.ps1",
    "prebuild": "node scripts/prepare-assets.mjs",
    "predev": "node scripts/prepare-assets.mjs"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "6.5.0",
    "@codemirror/search": "6.5.11",
    "@tauri-apps/api": "2.12.5",
    "@uiw/react-codemirror": "4.25.4",
    "codemirror": "6.0.2",
    "pdfjs-dist": "5.4.624",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tauri-apps/cli": "2.12.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "4.1.12",
    "prettier": "3.6.2"
  }
}
