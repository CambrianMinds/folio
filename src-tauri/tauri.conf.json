{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Folio",
  "version": "0.2.0",
  "identifier": "local.folio.publisher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Folio",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": [
      "resources/"
    ],
    "copyright": "© 2026 Justin Bogner/CambrianMinds",
    "publisher": "CambrianMinds",
    "license": "GPL-2.0-or-later",
    "licenseFile": "../LICENSE",
    "shortDescription": "Markdown, composed for the printed page.",
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "compression": "zlib"
      }
    }
  }
}
